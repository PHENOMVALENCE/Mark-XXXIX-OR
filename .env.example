# ---------------------------------------------------------------------------
# VALENCE — environment configuration template
#
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# Every value here is optional at startup. VALENCE starts with whatever is
# configured and reports the rest as unavailable rather than crashing.
# ---------------------------------------------------------------------------

# --- Assistant identity ----------------------------------------------------
# The name the assistant answers to and refers to itself as.
VALENCE_ASSISTANT_NAME=Valence

# How the assistant addresses you. Leave blank for no honorific.
VALENCE_USER_HONORIFIC=

# --- Intelligence providers ------------------------------------------------
# Gemini — powers the real-time voice session (Live API) and vision.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — powers text-only reasoning for tools (search, memory, planning).
# Get a free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional additional providers. Leave blank if unused — the provider is simply
# not registered and routing falls back to whatever is configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Base URL of a local OpenAI-compatible server (Ollama, LM Studio, llama.cpp).
# Example: http://localhost:11434/v1
LOCAL_LLM_BASE_URL=

# --- Platform --------------------------------------------------------------
# windows | mac | linux. Leave blank to auto-detect from the host OS.
VALENCE_OS=

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
VALENCE_LOG_LEVEL=INFO

# Directory for structured logs and the audit trail. Relative to the repo root.
VALENCE_LOG_DIR=logs

# ---------------------------------------------------------------------------
# NOT YET IMPLEMENTED — reserved for later phases.
# These are documented here so the intended configuration surface is visible,
# but nothing reads them yet.
# ---------------------------------------------------------------------------

# Google OAuth (Calendar + Gmail). Register at https://console.cloud.google.com
# Store the downloaded client secret JSON outside the repo, or in config/ where
# .gitignore already excludes it.
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=
# GOOGLE_OAUTH_TOKEN_FILE=

# Spotify. Register at https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# GitHub personal access token, read-only scopes recommended.
# GITHUB_TOKEN=

# Weather provider.
# OPENWEATHER_API_KEY=
